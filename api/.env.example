# ============================================================================
# AI VOCABULARY WEBSITE - SERVER ENVIRONMENT VARIABLES
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED: Primary AI Provider (Groq)
# ----------------------------------------------------------------------------
# Get your free API key from: https://console.groq.com/keys
# Groq provides fast inference with generous free tier
# Used for generating vocabulary definitions and related words
GROQ_API_KEY=your_groq_api_key_here

# ----------------------------------------------------------------------------
# OPTIONAL: Fallback AI Provider (Hugging Face)
# ----------------------------------------------------------------------------
# Get your free API key from: https://huggingface.co/settings/tokens
# Used as fallback when Groq rate limits are exceeded
# Recommended for production deployments
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ----------------------------------------------------------------------------
# VERCEL KV STORAGE (Auto-configured by Vercel)
# ----------------------------------------------------------------------------
# These are automatically set when you enable Vercel KV for your project
# DO NOT manually set these - Vercel will inject them automatically
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ----------------------------------------------------------------------------
# NOTES:
# ----------------------------------------------------------------------------
# 1. Copy this file to .env (or configure in Vercel dashboard for production)
# 2. At minimum, you MUST provide GROQ_API_KEY
# 3. HUGGINGFACE_API_KEY is optional but recommended for better reliability
# 4. Vercel KV variables are managed by Vercel - don't set them manually
# 5. Never commit .env files to git (already in .gitignore)
